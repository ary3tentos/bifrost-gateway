# Copie para .env (chmod 600) e preencha. O .env nunca vai para o git.

# --- Azure AI Foundry -------------------------------------------------------
# Endpoint do recurso, sem /openai/... no final.
AZURE_ENDPOINT=https://<recurso>.cognitiveservices.azure.com
# Key do recurso. Só o gateway conhece este valor.
AZURE_API_KEY=

# --- Bifrost ----------------------------------------------------------------
# Criptografa as keys no config.db. NÃO pode mudar depois sem apagar o banco.
# Gere uma vez e guarde no cofre de senhas: openssl rand -base64 32
BIFROST_ENCRYPTION_KEY=

# Login da UI/API de admin (acesso só por túnel SSH).
BIFROST_ADMIN_USERNAME=admin
BIFROST_ADMIN_PASSWORD=

# --- Virtual keys (uma por app) ---------------------------------------------
# Tem que começar com sk-bf- para o header api-key ser lido como virtual key.
# Gere com: echo "sk-bf-$(openssl rand -hex 24)"
BIFROST_VK_CHAT_AI=
